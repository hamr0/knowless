# Local Claude settings & runtime artifacts — never commit these
# (tracked memory files under .claude/memory/ are deliberately not ignored)
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/stash/

# Node ecosystem
node_modules/
*.log
.DS_Store

# Generated TypeScript declarations — emitted from JSDoc by `npm run build:types`
# (tsc), shipped to npm via the prepublishOnly hook. Never committed, so no
# committed artifact can drift from the source JSDoc.
/types/

# SQLite artifacts (POC + dev)
*.sqlite
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal
*.db

# Editor / IDE
.idea/
.vscode/
*.swp

# Agent / IDE / tooling scratch — ignore EVERY dot-directory by default
# (.claude, .litectx, .idea, .barebrowse, .vscode, and whatever the next tool
# invents), then re-admit only the ones we actually ship. Default-deny beats
# chasing each new scratch dir with its own line.
.*/
!.github/
